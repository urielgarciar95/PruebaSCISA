@{
    ViewData["Title"] = "Poke API";
}

<div class="row">
    <div class="col-md-3">
        <input type="text" name="nombre" id="nombre" class="form-control" placeholder="Nombre de pokemon" value="" />
    </div>
    <div class="col-md-3">
        <select class="form-control" id="especies">
            <option>Seleccionar especie...</option>
        </select>
    </div>
    <div class="col-md-1">
        <button type="button" class="btn btn-success">Excel</button>
    </div>
    <div class="col-md-2">
        <button type="button" class="btn btn-primary">Enviar Correo</button>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <table class="table">
            <tr>
                <th>Nombre</th>
                <th>Imagen</th>
            </tr>
        </table>
    </div>
</div>
